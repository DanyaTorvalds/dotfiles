# === GENERAL ===
max-visible=5
max-history=20
sort=-time
layer=overlay
anchor=top-right
margin=10
padding=15
border-size=1
border-radius=12
max-icon-size=48

# === STYLE ===
background-color=#141414F2
text-color=#FFFFFFFF
border-color=#FFFFFF33
progress-color=#FFFFFFFF

# === FONT ===
font=JetBrains Mono 11

# === ACTIONS ===
on-button-left=dismiss
on-button-right=dismiss-all
on-button-middle=invoke-default-action

# === FORMAT ===
format=<b>%s</b>\n%b

# === TIMEOUT ===
default-timeout=5000
